    dateformat -%Y%m%d-%H%M%S
}

# --- Nginx ---
/var/log/nginx/access.log
/var/log/nginx/error.log {
    daily
    rotate 10
    compress
    missingok
    notifempty
    create 0640 nginx root
    sharedscripts
    postrotate
        [ -s /run/nginx.pid ] && kill -USR1 `cat /run/nginx.pid`
