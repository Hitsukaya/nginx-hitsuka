# --- PHP-FPM ---
/var/log/php-fpm/*.log {
    weekly
    rotate 4
    compress
    missingok
    notifempty
    create 0640 root adm
    sharedscripts
    postrotate
        [ -s /run/php-fpm/www.pid ] && kill -USR1 `cat /run/php-fpm/www.pid`
